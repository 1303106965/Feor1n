<Project>

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<InvariantGlobalization>false</InvariantGlobalization>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest</AnalysisLevel>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<NeutralLanguage>zh-CN</NeutralLanguage>
	</PropertyGroup>

	<PropertyGroup>
		<Product>CC Our Story</Product>
		<Company>keeleycenc</Company>
		<Authors>keeleycenc</Authors>
		<Copyright>Copyright (c) keeleycenc</Copyright>
		<Version>1.0.0</Version>
		<RepositoryUrl>https://github.com/keeleycenc/CC.OurStory</RepositoryUrl>
	</PropertyGroup>

	<!-- 所有项目共用同一套包版本，升级时只改这里 -->
	<PropertyGroup>
		<MicrosoftExtensionsVersion>10.0.12</MicrosoftExtensionsVersion>
		<EntityFrameworkVersion>10.0.12</EntityFrameworkVersion>
		<SQLitePCLRawVersion>3.0.5</SQLitePCLRawVersion>
		<MarkdigVersion>1.4.0</MarkdigVersion>
		<MailKitVersion>4.18.1</MailKitVersion>
		<XunitVersion>2.9.3</XunitVersion>

		<!-- 固定 3.1.x：4.x 起直接引用 ImageSharp 需要在构建时提供 Six Labors License Key。 -->
		<ImageSharpVersion>3.1.12</ImageSharpVersion>

		<!-- ImageSharp 3.1.12 是 3.1.x 的最终版，其已知漏洞暂无修复版可升（4.x 需 License Key），
		     把这些审计项降级为警告，避免恢复包时直接构建失败；上游发布修复版后再随版本号一起清理。 -->
		<WarningsNotAsErrors>$(WarningsNotAsErrors);NU1902;NU1903</WarningsNotAsErrors>
	</PropertyGroup>

</Project>
